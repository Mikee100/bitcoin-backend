# Optional: email alerts when a trade opportunity (LONG_ENTRY / SHORT_ENTRY) is found.
# Copy this file to .env and set your values. Leave EMAIL_ENABLED=false to disable.

EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
NOTIFY_EMAIL=your_email@gmail.com

# Gmail: use an "App Password" (not your normal password).
# See: https://support.google.com/accounts/answer/185833
