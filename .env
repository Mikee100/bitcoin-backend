# PostgreSQL (Neon) - set for persistent DB; otherwise SQLite is used.
# Get connection string from Neon Dashboard. Never commit real credentials.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Optional: email alerts when a trade opportunity (LONG_ENTRY / SHORT_ENTRY) is found.
# Copy this file to .env and set your values. Leave EMAIL_ENABLED=false to disable.

EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_EMAIL=

# Gmail: use an "App Password" (not your normal password).
# See: https://support.google.com/accounts/answer/185833
